# Build artifacts.  These were committed historically; stale object files
# defeat make's dependency check and cause it to link a prebuilt binary of
# the wrong architecture instead of recompiling.
*.o
*.o30
*.o40
# Anchored to the root on purpose: an unanchored "pdb2pov" also matches the
# Python package directory at python/src/pdb2pov, which git would then
# exclude in its entirety without saying so.
/pdb2pov

# Editor backups
*~

# Generated scenes and renders
*.pov
!crambin.pov
*.png
*.tga

# 'make check' artefacts
check_crambin.pdb
check_crambin_*.inc
check_*.tmp
check_elements*.pov
check_elements*.png
python/check_py_*.inc

# Python
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
.venv/
